diff --git a/kernel/sys_revstr.c b/kernel/sys_revstr.c
new file mode 100644
index 000000000..d8634de73
--- /dev/null
+++ b/kernel/sys_revstr.c
@@ -0,0 +1,42 @@
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+/* Syscall 1: sys_revstr (ID: 451) */
+SYSCALL_DEFINE2(revstr, char __user *, str, size_t, n)
+{
+    char *kbuf;
+    int i;
+    char temp;
+
+    if (!str || n == 0) return -EINVAL;
+
+    kbuf = kmalloc(n + 1, GFP_KERNEL);
+    if (!kbuf) return -ENOMEM;
+
+    if (copy_from_user(kbuf, str, n)) {
+        kfree(kbuf);
+        return -EFAULT;
+    }
+    kbuf[n] = '\0';
+
+    printk(KERN_INFO "The origin string: %s\n", kbuf);
+
+    for (i = 0; i < n / 2; i++) {
+        temp = kbuf[i];
+        kbuf[i] = kbuf[n - 1 - i];
+        kbuf[n - 1 - i] = temp;
+    }
+
+    printk(KERN_INFO "The reversed string: %s\n", kbuf);
+
+    if (copy_to_user(str, kbuf, n)) {
+        kfree(kbuf);
+        return -EFAULT;
+    }
+
+    kfree(kbuf);
+    return 0;
+}
diff --git a/kernel/sys_tempbuf.c b/kernel/sys_tempbuf.c
new file mode 100644
index 000000000..7132301c8
--- /dev/null
+++ b/kernel/sys_tempbuf.c
@@ -0,0 +1,89 @@
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+
+/* Syscall 2: sys_tempbuf (ID: 452) */
+
+struct temp_node {
+    char *data;
+    struct list_head list;
+};
+
+static LIST_HEAD(temp_list);
+static DEFINE_MUTEX(temp_lock);
+
+enum mode { PRINT = 0, ADD = 1, REMOVE = 2 };
+
+SYSCALL_DEFINE3(tempbuf, int, mode, void __user *, data, size_t, size)
+{
+    struct temp_node *entry, *tmp;
+    char *kbuf, *out_buf;
+    int ret = 0;
+
+    if (mode != PRINT && (!data || size == 0)) return -EFAULT;
+
+    mutex_lock(&temp_lock);
+
+    if (mode == ADD) {
+        entry = kmalloc(sizeof(struct temp_node), GFP_KERNEL);
+        if (!entry) { mutex_unlock(&temp_lock); return -ENOMEM; }
+
+        entry->data = kmalloc(size + 1, GFP_KERNEL);
+        if (!entry->data) { kfree(entry); mutex_unlock(&temp_lock); return -ENOMEM; }
+
+        if (copy_from_user(entry->data, data, size)) {
+            kfree(entry->data); kfree(entry); mutex_unlock(&temp_lock); return -EFAULT;
+        }
+        entry->data[size] = '\0';
+
+        list_add_tail(&entry->list, &temp_list);
+        printk(KERN_INFO "[tempbuf] Added: %s\n", entry->data);
+        ret = 0;
+
+    } else if (mode == REMOVE) {
+        kbuf = kmalloc(size + 1, GFP_KERNEL);
+        if (!kbuf) { mutex_unlock(&temp_lock); return -ENOMEM; }
+
+        if (copy_from_user(kbuf, data, size)) { kfree(kbuf); mutex_unlock(&temp_lock); return -EFAULT; }
+        kbuf[size] = '\0';
+
+        ret = -ENOENT;
+        list_for_each_entry_safe(entry, tmp, &temp_list, list) {
+            if (strcmp(entry->data, kbuf) == 0) {
+                printk(KERN_INFO "[tempbuf] Removed: %s\n", entry->data);
+                list_del(&entry->list);
+                kfree(entry->data); kfree(entry);
+                ret = 0;
+                break;
+            }
+        }
+        kfree(kbuf);
+
+    } else if (mode == PRINT) {
+        out_buf = kzalloc(512, GFP_KERNEL);
+        if (!out_buf) { mutex_unlock(&temp_lock); return -ENOMEM; }
+
+        bool first = true;
+        list_for_each_entry(entry, &temp_list, list) {
+            if (!first) strlcat(out_buf, " ", 512);
+            strlcat(out_buf, entry->data, 512);
+            first = false;
+        }
+        printk(KERN_INFO "[tempbuf] %s\n", out_buf);
+
+        int actual_len = strlen(out_buf);
+        if (size < actual_len) actual_len = size;
+
+        if (copy_to_user(data, out_buf, actual_len)) { kfree(out_buf); mutex_unlock(&temp_lock); return -EFAULT; }
+        ret = actual_len;
+        kfree(out_buf);
+    } else {
+        ret = -EINVAL;
+    }
+    mutex_unlock(&temp_lock);
+    return ret;
+}
